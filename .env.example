# DB Admin configuration. Every variable is optional; the defaults are shown.
# Variables set in the real environment (e.g. PHP-FPM env[...]) take precedence
# over this file, and config.php, when present, takes precedence over both.

DB_ADMIN_TITLE="DB Admin"
# Linked from the signed-out page.
DB_ADMIN_PANEL_URL=

# The database server every session connects to. The sign-on token supplies
# only the credentials, never the server.
DB_ADMIN_DB_HOST=127.0.0.1
DB_ADMIN_DB_PORT=3306
# A Unix socket instead of host and port.
DB_ADMIN_DB_SOCKET=
DB_ADMIN_DB_TIMEOUT=5
DB_ADMIN_DB_READ_TIMEOUT=300
# TLS to the server. Leave SSL_CA empty to use the system's trust store.
DB_ADMIN_DB_SSL=false
DB_ADMIN_DB_SSL_CA=
DB_ADMIN_DB_SSL_VERIFY=true

# Databases never listed or opened, comma separated.
DB_ADMIN_HIDDEN_DATABASES=information_schema,performance_schema,mysql,sys

# Sign-on tokens: where the control panel drops them, and how long they last.
DB_ADMIN_TOKEN_DIR=
DB_ADMIN_TOKEN_TTL=60

# Sessions. Leave SESSION_PATH empty to use storage/sessions.
DB_ADMIN_SESSION_PATH=
DB_ADMIN_SESSION_NAME=DbAdminSession
# Set to false only for local development over plain HTTP.
DB_ADMIN_SESSION_SECURE=true
DB_ADMIN_SESSION_IDLE_TIMEOUT=1800
DB_ADMIN_SESSION_LIFETIME=28800

# Limits.
DB_ADMIN_PAGE_SIZE=50
DB_ADMIN_CELL_PREVIEW=1024
DB_ADMIN_VALUE_PREVIEW=1048576
DB_ADMIN_QUERY_ROWS=1000
DB_ADMIN_EXACT_COUNT=100000
DB_ADMIN_DECODE_SERIALIZED=true
