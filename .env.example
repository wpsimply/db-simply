# DB Simply configuration. Every variable is optional; the defaults are shown.
# Variables set in the real environment (e.g. PHP-FPM env[...]) take precedence
# over this file, and config.php, when present, takes precedence over both.

DB_SIMPLY_TITLE="DB Simply"
# Linked from the signed-out page.
DB_SIMPLY_PANEL_URL=

# The database server every session connects to. The sign-on token supplies
# only the credentials, never the server.
DB_SIMPLY_DB_HOST=127.0.0.1
DB_SIMPLY_DB_PORT=3306
# A Unix socket instead of host and port.
DB_SIMPLY_DB_SOCKET=
DB_SIMPLY_DB_TIMEOUT=5
DB_SIMPLY_DB_READ_TIMEOUT=300
# TLS to the server. Leave SSL_CA empty to use the system's trust store.
DB_SIMPLY_DB_SSL=false
DB_SIMPLY_DB_SSL_CA=
DB_SIMPLY_DB_SSL_VERIFY=true

# Databases never listed or opened, comma separated.
DB_SIMPLY_HIDDEN_DATABASES=information_schema,performance_schema,mysql,sys

# Sign-on tokens: where the control panel drops them, and how long they last.
DB_SIMPLY_TOKEN_DIR=
DB_SIMPLY_TOKEN_TTL=60
# The panel page that issues a token bound to the browser: sso.php?start sends
# the browser there with ?binding=<hash>. See "Signing users in" in README.md.
DB_SIMPLY_SSO_ISSUE_URL=
# Once the panel binds every token, refuse any token that is not bound.
DB_SIMPLY_SSO_REQUIRE_BINDING=false

# Imports: where uploads are kept while they run, the largest file accepted
# (bytes; a gzipped upload may decompress to 20 times this), and the seconds
# each request spends running statements before it reports progress.
DB_SIMPLY_IMPORT_DIR=
DB_SIMPLY_IMPORT_MAX_BYTES=2147483648
DB_SIMPLY_IMPORT_BUDGET=20

# Sessions. Leave SESSION_PATH empty to use storage/sessions.
DB_SIMPLY_SESSION_PATH=
DB_SIMPLY_SESSION_NAME=DbSimplySession
# Set to false only for local development over plain HTTP.
DB_SIMPLY_SESSION_SECURE=true
DB_SIMPLY_SESSION_IDLE_TIMEOUT=1800
DB_SIMPLY_SESSION_LIFETIME=28800

# Limits.
DB_SIMPLY_PAGE_SIZE=50
DB_SIMPLY_CELL_PREVIEW=1024
DB_SIMPLY_VALUE_PREVIEW=1048576
DB_SIMPLY_QUERY_ROWS=1000
DB_SIMPLY_EXACT_COUNT=100000
DB_SIMPLY_DECODE_SERIALIZED=true
# Prefix CSV values that a spreadsheet would run as a formula (=, +, -, @)
# with a quote, for exports opened in Excel or Sheets. Numbers are left alone.
DB_SIMPLY_CSV_ESCAPE_FORMULAS=false
